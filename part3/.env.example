# Copy to .env and adjust. Never commit .env.
#
# Generate strong secrets, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=
JWT_SECRET_KEY=

# SQLite (default): file next to run.py
DATABASE_URL=sqlite:///development.db

# Optional: MySQL/Postgres in production
# DATABASE_URL=mysql+pymysql://user:pass@localhost/hbnb
