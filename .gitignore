# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/

# Secrets — never commit
.env
.env.local
*.pem

# SQLite (Uncommented to allow pushing DB files if desired)
*.db
*.db-wal
*.db-shm

# App backups & instance (allow .db files, ignore others)
part3/backups/*
!part3/backups/.gitkeep
!part3/backups/*.db
part3/instance/*
!part3/instance/*.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.idea/
.vscode/
*.swp
# Thumbs.db
.DS_Store
